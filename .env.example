# =============================================================================
# VenderSathi — Environment Variables Template
# Copy to backend/.env and supply real credentials before enabling 3rd-party APIs
# =============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=VenderSathi
APP_VERSION=1.0.0

# Database: 'sqlite' (local file) or 'postgres' (PostgreSQL 14+)
DB_DIALECT=sqlite
DB_STORAGE=./data/vendersathi.sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendersathi
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_LOGGING=false

# Authentication (Required in production: minimum 32 random characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Redis Cache (Optional — set REDIS_ENABLED=true when Redis server is available)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Online Payments — Razorpay (Optional — online checkout activates ONLY when both keys are set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS OTP — Twilio (Optional — SMS OTP activates ONLY when configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# External Maps & Weather (Optional — leave blank if unused)
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=

# Python AI Microservice
AI_API_BASE_URL=http://127.0.0.1:5000/api/v1

CORS_ORIGIN=http://localhost:8080
DEFAULT_CURRENCY=INR
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=Asia/Kolkata
