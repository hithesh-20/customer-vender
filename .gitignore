# =============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Build and compilation files
*.pyc
*.pyo
*.pyd
__pycache__/
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# =============================================================================
# Node.js / Backend
# =============================================================================

# Dependencies
node_modules/

# npm debug logs
npm-debug.log*

# npm package-lock files (optional - can be committed)
# package-lock.json
# yarn.lock

# Test coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Local env files
.env
.env.test
.env.development
.env.production

# Build output
dist/
build/

